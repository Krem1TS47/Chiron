# Database
DATABASE_URL=postgresql://chiron:chiron@localhost:5432/chiron
POSTGRES_USER=chiron
POSTGRES_PASSWORD=chiron
POSTGRES_DB=chiron

# ESPN Fantasy (optional). Leave ESPN_SEASON blank to use the latest season.
ESPN_LEAGUE_ID=
ESPN_SEASON=
ESPN_SWID=
ESPN_S2=

# NBA ingestion. Leave NBA_SEASON blank to use the latest completed/current season.
NBA_SEASON=
INGEST_PLAYER_LIMIT=50

# ML
MODEL_DIR=/app/models
MIN_GAMES_FOR_FEATURES=5
ROLLING_WINDOWS=5,10,15

# API
API_HOST=0.0.0.0
API_PORT=8000

# Observability
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
